# Export these variables in your shell. Spring Boot does not load this file automatically.
# Use the portal's Decoding service key; the client URL-encodes it once.
PLUGPASS_PUBLIC_DATA_SERVICE_KEY=
PLUGPASS_PUBLIC_DATA_URL=https://apis.data.go.kr/B552584/EvCharger/getChargerInfo
PLUGPASS_PUBLIC_DATA_PAGE_SIZE=9999
PLUGPASS_PUBLIC_DATA_REGION=28
PLUGPASS_PUBLIC_DATA_CONNECT_TIMEOUT=3s
PLUGPASS_PUBLIC_DATA_RESPONSE_TIMEOUT=10s

PLUGPASS_INGESTION_ENABLED=false
PLUGPASS_INGESTION_DELAY=PT30M
PLUGPASS_INGESTION_MAX_PAGES=10
PLUGPASS_INGESTION_MAX_REQUESTS=20
PLUGPASS_INGESTION_MAX_RETRIES=1
PLUGPASS_INGESTION_RUN_TIMEOUT=PT120S
PLUGPASS_INGESTION_RETRY_DELAY=PT1S

# Required with the deployment profile. Spring does not automatically load this file.
# Production example: trusted CA + hostname verification. Replace db.internal.
# Keep verification-only loopback TLS options out of production configuration.
# SPRING_PROFILES_ACTIVE=deployment
PLUGPASS_DATABASE_URL=jdbc:mysql://db.internal:3306/plugpass?sslMode=VERIFY_IDENTITY
PLUGPASS_DATABASE_USERNAME=plugpass
PLUGPASS_DATABASE_PASSWORD=
MANAGEMENT_SERVER_PORT=8081
