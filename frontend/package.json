{
  "name": "plugpass-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run type-check && vite build",
    "build:native": "npm run type-check && vite build --mode native",
    "sync:native": "npm run build:native && cap sync",
    "build:ios": "bash ../scripts/build-ios.sh simulator",
    "build:ios:device": "bash ../scripts/build-ios.sh device",
    "build:android": "bash ../scripts/build-android.sh",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "axios": "1.20.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
